# Bu dosyayı .env olarak kopyalayıp kendi değerlerinizi girin:  cp .env.example .env
DB_URL=jdbc:postgresql://localhost:5432/eventify_db
DB_NAME=eventify_db
DB_USERNAME=postgres
DB_PASSWORD=change-me
# Base64 kodlu, en az 256 bit:  openssl rand -base64 64
JWT_SECRET=change-me
JWT_EXPIRATION=86400000
